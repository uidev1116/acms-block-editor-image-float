{#
  プラグインの設定画面。保存は a-blog cms 標準の設定保存（ACMS_POST_Config）で、
  config[] に列挙したキーがブログのコンフィグに保存される。
#}
{% set config = acms_config({ blogId: BID }) %}

<header>
  <div>
    @include("/admin/topicpath.html")
  </div>
  <div>
    <h1 class="acms-admin-admin-title js-dialog-title">
      BlockEditorImageFloat 設定
    </h1>
  </div>
</header>

{% if config.saved %}
<div role="alert" class="acms-admin-alert acms-admin-alert-info acms-admin-alert-icon">
  <span class="acms-admin-icon acms-admin-icon-news acms-admin-alert-icon-before" aria-hidden="true"></span>
  設定を保存しました。
  <button
    type="button"
    class="js-acms-alert-close acms-admin-alert-icon-after acms-admin-margin-right-mini"
    aria-label="閉じる"
  >
    ×
  </button>
</div>
{% endif %}

<form action="" method="post" class="acms-admin-form">
  <div class="js-acms_fix_marker acms_fix_bg">
    <div class="acms_fix_bg_index">
      <button
        type="submit"
        name="ACMS_POST_Config"
        class="acms-admin-btn-admin acms-admin-btn-admin-primary acms-admin-btn-admin-save js-saving-splash"
      >
        保存
      </button>
    </div>
  </div>

  <section>
    <h2 class="acms-admin-admin-title2">基本設定</h2>
    <div class="acms-admin-cssgrid">
      <div class="acms-admin-g-col-12 acms-admin-g-col-sm-2">
        <label for="block_editor_image_float_enabled" class="acms-admin-col-form-label">
          画像の回り込み<i class="acms-admin-icon-tooltip acms-admin-ms-1 js-acms-tooltip-hover" data-acms-tooltip="オフにすると、ブロックエディターのツールバーに「左に回り込み」「右に回り込み」を表示しません。保存済みの回り込みは通常の画像として表示されます。"></i>
        </label>
      </div>
      <div class="acms-admin-g-col-12 acms-admin-g-col-sm-10">
        <input type="hidden" name="block_editor_image_float_enabled" value="off">
        <div class="acms-admin-form-checkbox">
          <input
            type="checkbox"
            name="block_editor_image_float_enabled"
            value="on"
            {{ config.get('block_editor_image_float_enabled') != 'off' ? 'checked' : '' }}
            id="block_editor_image_float_enabled"
          >
          <label for="block_editor_image_float_enabled"><i class="acms-admin-ico-checkbox"></i>回り込みの配置を使う</label>
        </div>
        <input type="hidden" name="config[]" value="block_editor_image_float_enabled" />
      </div>
    </div>
  </section>
</form>
