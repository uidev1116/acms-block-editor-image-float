{
  "name": "acms-block-editor-image-float",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "npm run build",
    "dev": "vite build --watch --mode development",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"frontend/**/*.{ts,css}\" \"tests/js/**/*.ts\" \"*.{ts,js,mjs,json}\"",
    "format:check": "prettier --check \"frontend/**/*.{ts,css}\" \"tests/js/**/*.ts\" \"*.{ts,js,mjs,json}\"",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "prepare": "husky"
  },
  "dependencies": {
    "@ablogcms/i18n": "3.2.37",
    "@ablogcms/plugins": "3.2.37"
  },
  "devDependencies": {
    "@ablogcms/block-editor": "3.2.37",
    "@ablogcms/types": "3.2.37",
    "@eslint/js": "^10.0.1",
    "@tiptap/core": "^3.32.2",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/pm": "^3.32.2",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8",
    "vitest": "^5.0.5"
  },
  "volta": {
    "node": "24.22.0"
  },
  "lint-staged": {
    "*.{ts,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json}": [
      "prettier --write"
    ]
  }
}
